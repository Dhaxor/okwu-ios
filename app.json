{
  "expo": {
    "name": "Okwu",
    "slug": "okwu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "okwu",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5EEE1",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.okwu.learn",
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.okwu.learn",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F2552"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F5EEE1"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Okwu records your voice only so you can hear yourself next to a native speaker. Recordings stay on your phone unless you send one to your Family Circle.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1F2552"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "primaryColor": "#1F2552",
    "extra": {
      "eas": {
        "projectId": "291914e9-8bd3-4215-865e-8c907c33a57e"
      }
    },
    "owner": "dhaxor"
  }
}
